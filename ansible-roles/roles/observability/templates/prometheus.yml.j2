global:
  scrape_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:9090

  - job_name: monitoring-vm
    static_configs:
      - targets:
          - 192.168.137.13:9100

  - job_name: k8s-nodes
    static_configs:
      - targets:
{% for host in groups['k8s'] %}
          - "{{ hostvars[host].ansible_host }}:9100"
{% endfor %}
{% for host in groups['monitoring'] %}
          - "{{ hostvars[host].ansible_host }}:9100"
{% endfor %}

  - job_name: kube-state-metrics
    static_configs:
      - targets:
          - "192.168.137.10:30080"


  - job_name: "proxmox"
    static_configs:
      - targets:
          - "192.168.137.13:9221"